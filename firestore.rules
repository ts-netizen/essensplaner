rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function getUserHouseholdId() {
      return exists(getUserDoc()) ? get(getUserDoc()).data.currentHouseholdId : null;
    }

    function getHouseholdDoc(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() &&
        exists(getHouseholdDoc(householdId)) &&
        'members' in get(getHouseholdDoc(householdId)).data &&
        request.auth.uid in get(getHouseholdDoc(householdId)).data.members;
    }

    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) &&
        get(getHouseholdDoc(householdId)).data.members[request.auth.uid].role == 'owner';
    }

    function isFriendHousehold(householdId) {
      let userHId = getUserHouseholdId();
      return isAuthenticated() &&
        userHId != null &&
        exists(getHouseholdDoc(householdId)) &&
        'friendHouseholdIds' in get(getHouseholdDoc(householdId)).data &&
        userHId in get(getHouseholdDoc(householdId)).data.friendHouseholdIds;
    }

    // ===============================================================
    // 1. User Profiles (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      // User-Isolation: Ein Nutzer kann nur sein eigenes Profil lesen und schreiben
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // 2. Households (/households/{householdId})
    // ===============================================================
    match /households/{householdId} {
      // Haushalts-Isolation: Nur Mitglieder können den Haushalts-Stamm (inkl. Vorräte / pantryStaples) lesen
      // Freunde haben NIEMALS Zugriff auf diesen Stammbeleg (Schutz von Vorräten & internen Einstellungen)
      allow read: if isHouseholdMember(householdId);

      // Erstellung: Jeder authentifizierte Nutzer kann einen Haushalt anlegen,
      // sofern er sich selbst in 'members' mit Rolle 'owner' einträgt
      allow create: if isAuthenticated() &&
        request.resource.data.id == householdId &&
        request.auth.uid in request.resource.data.members &&
        request.resource.data.members[request.auth.uid].role == 'owner';

      // Bearbeitung: Nur bestehende Haushaltsmitglieder oder eingeladene Nutzer (bei Beitritt)
      allow update: if isHouseholdMember(householdId) || (
        isAuthenticated() &&
        // Beitritts-Szenario: Nutzer fügt sich selbst der members-Map hinzu
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
        request.auth.uid in request.resource.data.members
      );

      // Löschung: Nur der Haushalts-Owner
      allow delete: if isHouseholdOwner(householdId);

      // -------------------------------------------------------------
      // 2.1 Rezepte (/households/{householdId}/recipes/{recipeId})
      // -------------------------------------------------------------
      match /recipes/{recipeId} {
        // Haushaltsmitglieder: Voller Lesezugriff
        // Freunde: Selektiver Read-Only-Zugriff bei 'friends' oder 'public'
        // Andere authentifizierte Nutzer: Nur wenn explizit 'public'
        allow read: if isHouseholdMember(householdId) ||
          resource.data.visibility == 'public' ||
          (resource.data.visibility in ['friends', 'public'] && isFriendHousehold(householdId));

        // Schreibzugriff: Strikt reserviert für Haushaltsmitglieder
        allow create: if isHouseholdMember(householdId);
        allow update: if isHouseholdMember(householdId);
        allow delete: if isHouseholdMember(householdId);
      }

      // -------------------------------------------------------------
      // 2.2 Wochenpläne (/households/{householdId}/meal_plans/{weekId})
      // -------------------------------------------------------------
      match /meal_plans/{weekId} {
        // Haushaltsmitglieder: Voller Lesezugriff
        // Freunde: Read-Only ("Was kocht Familie Meyer diese Woche?")
        allow read: if isHouseholdMember(householdId) || isFriendHousehold(householdId);

        // Schreibzugriff: Strikt reserviert für Haushaltsmitglieder
        allow create: if isHouseholdMember(householdId);
        allow update: if isHouseholdMember(householdId);
        allow delete: if isHouseholdMember(householdId);
      }

      // -------------------------------------------------------------
      // 2.3 Einkaufsliste (/households/{householdId}/shopping_list/{itemId})
      // -------------------------------------------------------------
      match /shopping_list/{itemId} {
        // STRIKTE DATENTRENNUNG: Freunde haben NIEMALS Zugriff auf die Einkaufsliste
        // Ausschließlich Mitglieder des jeweiligen Haushalts dürfen lesen und schreiben
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && request.resource.data.addedBy == request.auth.uid;
        allow update: if isHouseholdMember(householdId);
        allow delete: if isHouseholdMember(householdId);
      }
    }

    // ===============================================================
    // 3. Globaler Wissens-Cache (/ingredients_knowledge/{canonicalId})
    // ===============================================================
    match /ingredients_knowledge/{canonicalId} {
      // Globaler Lesezugriff für alle authentifizierten Nutzer
      allow read: if isAuthenticated();

      // Schreibzugriff vom Client gesperrt (wird serverseitig via Cloud Run BFF / Firebase Admin geschrieben)
      allow write: if false;
    }
  }
}
